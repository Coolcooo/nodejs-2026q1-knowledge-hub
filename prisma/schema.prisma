generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id
  login     String    @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  articles  Article[]
  comments  Comment[]
}

model Article {
  id         String    @id
  title      String
  content    String
  status     Status
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  author     User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId   String?
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?
  comments   Comment[]
  tags Tag[]
  @@index([status])
  @@index([categoryId])
}

model Category {
  id          String    @id
  name        String
  description String
  articles    Article[]
}

model Comment {
  id        String  @id
  content   String
  createdAt DateTime @default(now())
  author    User?    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String?
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String
}

model RefreshToken {
  value String @id
}

model Tag {
  id   String @id
  name String @unique
  articles Article[]
}

enum Role {
  admin
  editor
  viewer
}

enum Status {
  draft
  published
  archived
}
